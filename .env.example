# Primary read-only page API. Configure this in production.
VITE_NEWS_API_URL=

# Optional HTTP(S) browser-fallback proxy overrides. The built-in defaults are
# RSS2JSON and AllOrigins; automated tests mock both and never call live feeds.
VITE_RSS_PROVIDER_URL=
VITE_RSS_RAW_PROXY_URL=

# Required for the deployed EmailJS contact form.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
