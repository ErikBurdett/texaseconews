# Primary read-only page API. Configure this in production.
VITE_NEWS_API_URL=

# Production default is false. Enable only after the sources and proxy terms in
# rss_source_compliance.md are approved and required licenses are documented.
VITE_ENABLE_RSS_FALLBACK=false

# Optional HTTP(S) browser-fallback proxy overrides. These are used only when
# RSS fallback is enabled. Public RSS2JSON and AllOrigins defaults are suitable
# for mocked development tests, not an approved production rights posture.
VITE_RSS_PROVIDER_URL=
VITE_RSS_RAW_PROXY_URL=

# Required for the deployed EmailJS contact form.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
